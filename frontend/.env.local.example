# Leave unset to use the built-in mock API routes under src/app/api/*.
# Point this at the real FastAPI backend wrapper once it exists, e.g.:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=

# Firebase Admin service account, used server-side only by
# src/app/api/pipeline/submit to temporarily store a submission in Firestore
# while it's processed, then delete it. Get these from Firebase Console >
# Project Settings > Service Accounts > Generate new private key (see
# README.md for full steps). Never commit real values or prefix them with
# NEXT_PUBLIC_ -- they must never reach the browser bundle.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
